{
  "name": "@yggdrasil/lab",
  "productName": "Yggdrasil Lab",
  "version": "0.3.6",
  "description": "Yggdrasil Lab — desktop observatory for artificial-life experiments.",
  "private": true,
  "main": "./out/main/index.js",
  "author": {
    "name": "PlayrZone"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:win:dir": "electron-vite build && electron-builder --win --dir",
    "release": "electron-vite build && electron-builder --win --publish always",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@yggdrasil/engine": "workspace:*",
    "@yggdrasil/home": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/three": "^0.171.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
