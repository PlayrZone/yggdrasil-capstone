{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "verbatimModuleSyntax": false
  },
  // env.d.ts rides along because the tests typecheck renderer modules, and those
  // reference the ambient `window.lab` / `window.__ygg` the renderer declares.
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/renderer/env.d.ts", "test/**/*.ts", "electron.vite.config.ts"]
}
