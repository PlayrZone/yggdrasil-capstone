{
  "name": "@yggdrasil/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Yggdrasil Lab MCP server: run, watch, query, and steer artificial-life experiments. Read-first; mutations allowlisted + logged.",
  "bin": {
    "yggdrasil-mcp": "./src/index.ts"
  },
